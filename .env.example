# --- AgentEval configuration -------------------------------------------------
# Copy to .env and edit. Every value below is also the built-in default.

AGENTEVAL_REDIS_URL=redis://localhost:6379/0

# Provider for planner/worker/critic reasoning and discover-agent:
# mock | openai | azure_openai | anthropic | ollama. Discovery requires a non-mock provider.
AGENTEVAL_LLM_PROVIDER=mock
# Provider used by the LLM judge. Keep it different from the executor provider
# so the judge is not grading its own generation.
AGENTEVAL_JUDGE_PROVIDER=mock

AGENTEVAL_OPENAI_API_KEY=
AGENTEVAL_OPENAI_MODEL=gpt-4o-mini
AGENTEVAL_OPENAI_BASE_URL=https://api.openai.com/v1
AGENTEVAL_OPENAI_INPUT_USD_PER_MILLION=0.15
AGENTEVAL_OPENAI_OUTPUT_USD_PER_MILLION=0.60

AGENTEVAL_AZURE_OPENAI_ENDPOINT=
AGENTEVAL_AZURE_OPENAI_API_KEY=
AGENTEVAL_AZURE_OPENAI_DEPLOYMENT=
AGENTEVAL_AZURE_OPENAI_API_VERSION=2024-10-21
# Set these to the deployment's current Azure pricing for cost accounting.
AGENTEVAL_AZURE_OPENAI_INPUT_USD_PER_MILLION=0.0
AGENTEVAL_AZURE_OPENAI_OUTPUT_USD_PER_MILLION=0.0

AGENTEVAL_ANTHROPIC_API_KEY=
AGENTEVAL_ANTHROPIC_MODEL=claude-3-5-haiku-20241022
AGENTEVAL_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
AGENTEVAL_ANTHROPIC_INPUT_USD_PER_MILLION=0.80
AGENTEVAL_ANTHROPIC_OUTPUT_USD_PER_MILLION=4.00

AGENTEVAL_OLLAMA_BASE_URL=http://localhost:11434
AGENTEVAL_OLLAMA_MODEL=llama3.2

# Reliability
AGENTEVAL_TOOL_TIMEOUT_S=10.0
AGENTEVAL_MAX_RETRIES=3
AGENTEVAL_BACKOFF_BASE_S=0.1
AGENTEVAL_BACKOFF_MAX_S=4.0
AGENTEVAL_BREAKER_FAILURE_THRESHOLD=5
AGENTEVAL_BREAKER_WINDOW_S=30.0
AGENTEVAL_BREAKER_RESET_S=15.0

# Budgets
AGENTEVAL_DEFAULT_MAX_COST_USD=0.50
AGENTEVAL_DEFAULT_MAX_LATENCY_MS=60000

# Tracing
AGENTEVAL_TRACE_DIR=traces

# Failure injection (bench only). 0.0 disables.
AGENTEVAL_INJECT_TOOL_TIMEOUT_RATE=0.0
AGENTEVAL_INJECT_LLM_429_RATE=0.0
